<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the portable TypeFlow.exe.
     GitHub uploads it as a zip, so the exe sits inside a zip-file element. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="TypeFlow.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
